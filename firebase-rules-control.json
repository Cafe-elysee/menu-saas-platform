{
  "rules": {
    "commandes": {
      ".read": false,
      "$commandeId": {
        ".write": "auth != null && !data.exists()",
        ".validate": "!newData.exists() || (newData.hasChildren(['ts']) && newData.child('ts').isNumber())"
      }
    },
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
