{
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Frame-Options":         "SAMEORIGIN",
        "Content-Security-Policy": "frame-ancestors 'self' https://menu-pro-demo.vercel.app https://genext-qr.com",
        "X-Content-Type-Options":  "nosniff",
        "Referrer-Policy":         "strict-origin-when-cross-origin",
        "Permissions-Policy":      "camera=(), microphone=(), geolocation=()"
      },
      "continue": true
    },
    { "src": "^/api/(.*)$",      "dest": "/api/$1" },
    { "src": "^/menu$",          "dest": "/index.html" },
    { "src": "^/admin$",         "dest": "/admin.html" },
    { "src": "^/site-api/(.*)$","dest": "https://menu-pro-demo.vercel.app/api/$1" },
    { "src": "^/$",              "dest": "https://menu-pro-demo.vercel.app/" },
    { "handle": "filesystem" },
    { "src": "^/(.*)$", "dest": "https://menu-pro-demo.vercel.app/$1" }
  ]
}
