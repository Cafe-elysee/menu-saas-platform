{
  "rewrites": [
    { "source": "/api/(.*)",      "destination": "/api/$1" },
    { "source": "/menu",          "destination": "/index.html" },
    { "source": "/admin",         "destination": "/admin.html" },
    { "source": "/site-api/(.*)", "destination": "https://menu-pro-demo.vercel.app/api/$1" },
    { "source": "/(.*)",          "destination": "https://menu-pro-demo.vercel.app/$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options",           "value": "SAMEORIGIN" },
        { "key": "Content-Security-Policy",   "value": "frame-ancestors 'self' https://menu-pro-demo.vercel.app https://genext-qr.com" },
        { "key": "X-Content-Type-Options",    "value": "nosniff" },
        { "key": "Referrer-Policy",           "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",        "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/MenuProServeur-SaaS-v1.0.apk",
      "headers": [
        { "key": "Content-Type",        "value": "application/vnd.android.package-archive" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"MenuProServeur-SaaS-v1.0.apk\"" }
      ]
    }
  ]
}
