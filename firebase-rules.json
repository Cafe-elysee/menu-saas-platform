{
  "rules": {
    "restaurants": {
      ".read": "auth != null && auth.token.role === 'platform'",
      "$rid": {
        "devices": {
          ".read": "auth != null && (auth.token.role === 'platform' || (auth.token.rid === $rid && (auth.token.role === 'admin' || auth.token.role === 'staff')))",
          ".write": "auth != null && (auth.token.role === 'platform' || (auth.token.rid === $rid && (auth.token.role === 'admin' || auth.token.role === 'staff')))",
          "$deviceId": {
            ".write": "auth != null && (auth.token.role === 'platform' || (auth.token.rid === $rid && (auth.token.role === 'admin' || auth.token.role === 'staff')))",
            ".validate": "!newData.exists() || (newData.hasChildren(['token','ts','lang']) && newData.child('token').isString() && newData.child('token').val().length < 300 && newData.child('ts').isNumber() && newData.child('lang').isString())"
          }
        },

        "orders": {
          ".read": true,
          ".write": "auth != null && (auth.token.rid === $rid || auth.token.role === 'platform')",
          "$orderId": {
            ".write": "auth != null && (auth.token.rid === $rid || auth.token.role === 'platform')",
            ".validate": "!newData.exists() || (newData.hasChildren(['table','ts']) && newData.child('ts').isNumber())"
          }
        },

        "calls": {
          ".read": true,
          ".write": "auth != null && (auth.token.rid === $rid || auth.token.role === 'platform')",
          "$callId": {
            ".write": "auth != null && (auth.token.rid === $rid || auth.token.role === 'platform')",
            ".validate": "!newData.exists() || (newData.hasChildren(['table','ts']) && newData.child('ts').isNumber())"
          }
        },

        "logs": {
          ".read": true,
          ".write": "auth != null && (auth.token.role === 'platform' || (auth.token.rid === $rid && (auth.token.role === 'admin' || auth.token.role === 'staff')))",
          "errors": {
            ".write": true,
            "$errId": {
              ".validate": "!newData.exists() || (newData.hasChildren(['msg','ts']) && newData.child('msg').isString() && newData.child('msg').val().length < 300 && newData.child('ts').isNumber())",
              "msg":  { ".validate": "newData.isString() && newData.val().length < 300" },
              "src":  { ".validate": "newData.isString() && newData.val().length < 200" },
              "line": { ".validate": "newData.isNumber()" },
              "ts":   { ".validate": "newData.isNumber()" },
              "ctx":  { ".validate": "newData.isString() && newData.val().length < 40" },
              "$other": { ".validate": false }
            }
          },
          "actions":  { ".write": "auth != null && (auth.token.role === 'platform' || (auth.token.rid === $rid && (auth.token.role === 'admin' || auth.token.role === 'staff')))" },
          "receipts": { ".write": "auth != null && (auth.token.rid === $rid || auth.token.role === 'platform')" }
        },

        "messages": {
          ".read": true,
          ".write": "auth != null && (auth.token.role === 'platform' || (auth.token.rid === $rid && (auth.token.role === 'admin' || auth.token.role === 'staff')))",
          "$msgId": {
            ".write": "auth != null && (auth.token.role === 'platform' || (auth.token.rid === $rid && (auth.token.role === 'admin' || auth.token.role === 'staff')))",
            ".validate": "!newData.exists() || (newData.hasChildren(['text','ts']) && newData.child('text').isString() && newData.child('text').val().length < 500 && newData.child('ts').isNumber())"
          }
        },

        "analytics": {
          ".read": true,
          ".write": "auth != null && (auth.token.rid === $rid || auth.token.role === 'platform')",
          "$dateKey": {
            ".write": "auth != null && (auth.token.rid === $rid || auth.token.role === 'platform')",
            ".validate": "!newData.exists() || newData.child('createdAt').isNumber()",
            "products": {
              "$productId": {
                "name": { ".validate": "newData.isString() && newData.val().length < 120" },
                "qty":  { ".validate": "newData.isNumber()" }
              }
            }
          }
        },

        "config": {
          ".read": "auth != null && (auth.token.role === 'platform' || (auth.token.rid === $rid && auth.token.role === 'admin'))",
          ".write": "auth != null && (auth.token.role === 'platform' || (auth.token.rid === $rid && auth.token.role === 'admin' && newData.child('active').val() === data.child('active').val() && newData.child('suspendu').val() === data.child('suspendu').val()))",
          "adminPwd": {
            ".validate": "!newData.exists()"
          },
          "active":       { ".read": true },
          "suspendu":     { },
          "defaultLang":  { ".read": true },
          "primaryLang":  { ".read": true },
          "enabledLangs": { ".read": true },
          "features":     { ".read": true },
          "retention":    { ".read": true },
          "tableCount":   { ".read": true }
        },

        "menu":      { ".read": true, ".write": "auth != null && (auth.token.role === 'platform' || (auth.token.rid === $rid && auth.token.role === 'admin'))" },
        "profile":   { ".read": true, ".write": "auth != null && (auth.token.role === 'platform' || (auth.token.rid === $rid && auth.token.role === 'admin'))" },
        "sessions":  { ".read": "auth != null && (auth.token.role === 'platform' || (auth.token.rid === $rid && auth.token.role === 'admin'))", ".write": "auth != null && (auth.token.role === 'platform' || (auth.token.rid === $rid && auth.token.role === 'admin'))" },
        "firstOpen": { ".read": true, ".write": true, ".validate": "newData.isBoolean()" }
      }
    },

    "archivedClients": {
      ".read": "auth != null && auth.token.role === 'platform'",
      "$slug": {
        ".write": "auth != null && auth.token.role === 'platform'"
      }
    },

    "control": {
      "fcm_tokens": {
        "$deviceId": {
          ".read": false,
          ".write": "auth != null && auth.token.role === 'platform'",
          ".validate": "!newData.exists() || (newData.hasChildren(['token','ts']) && newData.child('token').isString() && newData.child('token').val().length < 300 && newData.child('ts').isNumber())"
        }
      }
    },

    "demoPage": {
      ".read": true,
      ".write": "auth != null && auth.token.role === 'platform'",

      "guideContent": {
        "$articleId": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length < 500)"
        }
      }
    }
  }
}
