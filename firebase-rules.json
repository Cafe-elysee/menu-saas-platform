{
  "rules": {
    "restaurants": {
      ".read": "auth != null && auth.token.role === 'platform'",
      "$rid": {
        "devices": {
          ".read": true,
          ".write": "auth != null && (!data.exists() || (!newData.exists() && (auth.token.rid === $rid || auth.token.role === 'platform')))",
          "$deviceId": {
            ".write": "auth != null && (!data.exists() || newData.exists() || auth.token.rid === $rid || auth.token.role === 'platform')",
            ".validate": "!newData.exists() || (newData.hasChildren(['token','ts','lang']) && newData.child('token').isString() && newData.child('token').val().length < 300 && newData.child('ts').isNumber() && newData.child('lang').isString())"
          }
        },

        "orders": {
          ".read": true,
          ".write": "auth != null && (!data.exists() || (!newData.exists() && (auth.token.rid === $rid || auth.token.role === 'platform')))",
          "$orderId": {
            ".write": "auth != null && (!data.exists() || newData.exists() || auth.token.rid === $rid || auth.token.role === 'platform')",
            ".validate": "!newData.exists() || (newData.hasChildren(['table','ts']) && newData.child('ts').isNumber())"
          }
        },

        "calls": {
          ".read": true,
          ".write": "auth != null && (!data.exists() || (!newData.exists() && (auth.token.rid === $rid || auth.token.role === 'platform')))",
          "$callId": {
            ".write": "auth != null && (!data.exists() || newData.exists() || auth.token.rid === $rid || auth.token.role === 'platform')",
            ".validate": "!newData.exists() || (newData.hasChildren(['table','ts']) && newData.child('ts').isNumber())"
          }
        },

        "logs": {
          ".read": true,
          ".write": "auth != null && (!data.exists() || (!newData.exists() && (auth.token.rid === $rid || auth.token.role === 'platform')))",
          "errors": {
            ".write": true,
            "$errId": {
              ".validate": "!newData.exists() || (newData.hasChildren(['msg','ts']) && newData.child('msg').isString() && newData.child('msg').val().length < 300 && newData.child('ts').isNumber())"
            }
          },
          "actions":  { ".write": "auth != null && (auth.token.rid === $rid || auth.token.role === 'platform')" },
          "receipts": { ".write": "auth != null && (!data.exists() || newData.exists() || auth.token.rid === $rid || auth.token.role === 'platform')" }
        },

        "messages": {
          ".read": true,
          ".write": "auth != null && (!data.exists() || (!newData.exists() && (auth.token.rid === $rid || auth.token.role === 'platform')))",
          "$msgId": {
            ".write": "auth != null && (!data.exists() || newData.exists() || auth.token.rid === $rid || auth.token.role === 'platform')",
            ".validate": "!newData.exists() || (newData.hasChildren(['text','ts']) && newData.child('text').isString() && newData.child('text').val().length < 500 && newData.child('ts').isNumber())"
          }
        },

        "analytics": {
          ".read": true,
          ".write": true,
          "$dateKey": {
            ".validate": "!newData.exists() || newData.child('createdAt').isNumber()"
          }
        },

        "config": {
          ".read": "auth != null && (auth.token.rid === $rid || auth.token.role === 'platform')",
          ".write": "auth != null && (auth.token.rid === $rid || auth.token.role === 'platform')",
          "adminPwd": {
            ".validate": "!newData.exists()"
          },
          "active":       { ".read": true },
          "defaultLang":  { ".read": true },
          "enabledLangs": { ".read": true },
          "features":     { ".read": true }
        },

        "menu":      { ".read": true, ".write": "auth != null && (auth.token.rid === $rid || auth.token.role === 'platform')" },
        "profile":   { ".read": true, ".write": "auth != null && (auth.token.rid === $rid || auth.token.role === 'platform')" },
        "sessions":  { ".read": "auth != null && (auth.token.rid === $rid || auth.token.role === 'platform')", ".write": "auth != null && (auth.token.rid === $rid || auth.token.role === 'platform')" },
        "firstOpen": { ".read": true, ".write": true, ".validate": "newData.isBoolean()" }
      }
    },

    "archivedClients": {
      ".read": "auth != null && auth.token.role === 'platform'",
      "$slug": {
        ".write": "auth != null && auth.token.role === 'platform'"
      }
    },

    "control": {
      "fcm_tokens": {
        "$deviceId": {
          ".read": false,
          ".write": "auth != null && auth.token.role === 'platform'",
          ".validate": "!newData.exists() || (newData.hasChildren(['token','ts']) && newData.child('token').isString() && newData.child('token').val().length < 300 && newData.child('ts').isNumber())"
        }
      }
    },

    "demoPage": {
      ".read": true,
      ".write": "auth != null && auth.token.role === 'platform'",

      "guideContent": {
        "$articleId": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length < 500)"
        }
      }
    }
  }
}
