{
  "rules": {
    "restaurants": {
      ".read": true,

      "$rid": {
        "devices": {
          ".write": true,
          "$deviceId": {
            ".validate": "!newData.exists() || (newData.hasChildren(['token','ts','lang']) && newData.child('token').isString() && newData.child('token').val().length < 300 && newData.child('ts').isNumber() && newData.child('lang').isString())"
          }
        },

        "orders": {
          "$orderId": {
            ".write": "auth != null || data.exists()",
            ".validate": "!newData.exists() || (newData.hasChildren(['table','ts']) && newData.child('ts').isNumber())"
          }
        },

        "calls": {
          "$callId": {
            ".write": "auth != null || data.exists()",
            ".validate": "!newData.exists() || (newData.hasChildren(['table','ts']) && newData.child('ts').isNumber())"
          }
        },

        "logs": {
          "errors":  { ".write": true },
          "actions": { ".write": true },
          "orders":  { ".write": "auth != null" }
        },

        "messages": {
          ".write": true,
          "$msgId": {
            ".validate": "!newData.exists() || (newData.hasChildren(['text','ts']) && newData.child('text').isString() && newData.child('text').val().length < 500 && newData.child('ts').isNumber())"
          }
        },

        "analytics": {
          ".write": true,
          "$dateKey": {
            ".validate": "!newData.exists() || newData.child('createdAt').isNumber()"
          }
        },

        "config": {
          ".write": true,
          "adminPwd": {
            ".validate": "!newData.exists()"
          }
        },

        "menu":      { ".write": true },
        "profile":   { ".write": true },
        "sessions":  { ".write": true },
        "firstOpen": { ".write": true }
      }
    },

    "archivedClients": {
      ".read": true,
      "$slug": {
        ".write": true
      }
    },

    "control": {
      "fcm_tokens": {
        "$deviceId": {
          ".read": false,
          ".write": true,
          ".validate": "!newData.exists() || (newData.hasChildren(['token','ts']) && newData.child('token').isString() && newData.child('token').val().length < 300 && newData.child('ts').isNumber())"
        }
      }
    },

    "demoPage": {
      ".read": true,
      ".write": true,

      "guideContent": {
        "$articleId": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length < 500)"
        }
      }
    }
  }
}
